# Ground truth must never be touched. Tokenised BBC BASIC uses 0x0D as a
# record marker and the module is a binary; CRLF conversion corrupts both.
ref/**                     -text
ref/QTMModule              binary
ref/source-tokenised/**    binary
tools/*.exe                binary

# The log->linear table is a 256-byte blob with no extension, and it contains
# CR and LF bytes; with core.autocrlf=true git would corrupt it as text.
# Unanchored, so it covers every src/<variant>/LOGdata.
LOGdata                    binary

# Reference binaries for the variants that have no published build.
ref/QTMModule-*            binary

# *Exec'd into BASIC under RISC OS, which terminates text lines with LF.
tools/emulator/ListPtch*   text eol=lf

# Ordinary text
*.md                       text eol=lf
*.py                       text eol=lf
*.asm                      text eol=lf

# Audio measurements: recordings in Git LFS; the 256-byte tables are binary
recordings/*.wav           filter=lfs diff=lfs merge=lfs -text
recordings/*.bin           binary
tools/prep/linlog.bin      binary
*.json                     text eol=lf
tools/audio/arc/bin/*      binary
